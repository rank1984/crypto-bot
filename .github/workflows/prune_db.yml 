name: 🗑️ Prune Shadow DB

on:
  workflow_dispatch:

permissions:
  contents: write

jobs:
  prune:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          token: ${{ secrets.PAT_TOKEN || secrets.GITHUB_TOKEN }}
          fetch-depth: 0

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: DB size before
        run: ls -lh data/shadow.db

      - name: Prune
        run: python tools/prune_db.py

      - name: DB size after
        run: ls -lh data/shadow.db

      - name: Commit & push
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add -f data/shadow.db
          if git diff --staged --quiet; then
            echo "No changes"
          else
            git commit -m "🗑️ Prune DB [skip ci]"
            git push
          fi